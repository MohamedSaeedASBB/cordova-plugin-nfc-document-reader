# Python bytecode from running the calibration tools
__pycache__/
*.py[cod]

# The face-match model and the CSCA bundle ARE committed, despite being governance-controlled
# artefacts: MABS fetches this plugin from git at build time, so a file that is not in the
# repository never reaches a build, and plugin.xml's staging blocks would fail the install. The
# governance record travels with them instead — see src/models/PROVENANCE.md.

.DS_Store
